// Clock plus PMOD0 mapping supplied/confirmed by user, 2026-09-17.
// Control INPUT pins remain TODO: synthesis only, no automatic pin assignment.
IO_LOC "clk" H11;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "rpwm" T6;
IO_LOC "lpwm" P6;
IO_LOC "r_en" T7;
IO_LOC "l_en" R8;
IO_PORT "rpwm" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=DOWN;
IO_PORT "lpwm" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=DOWN;
IO_PORT "r_en" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=DOWN;
IO_PORT "l_en" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=DOWN;
// Internal pull-downs do not guarantee safe levels during FPGA configuration.
