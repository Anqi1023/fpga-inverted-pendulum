wire n16_6;
wire n36_5;
wire n34_7;
wire enabled;
wire held_dir;
wire [1:0] pwm_pair;
wire VCC;
wire GND;
  LUT2 n13_s0 (
    .F(n13_3),
    .I0(n36_5),
    .I1(n16_6) 
);
defparam n13_s0.INIT=4'h8;
  LUT2 rpwm_d_s (
    .F(rpwm_d),
    .I0(pwm_pair[0]),
    .I1(motor_r_en) 
);
defparam rpwm_d_s.INIT=4'h8;
  LUT2 lpwm_d_s (
    .F(lpwm_d),
    .I0(pwm_pair[1]),
    .I1(motor_r_en) 
);
defparam lpwm_d_s.INIT=4'h8;
  LUT4 n16_s2 (
    .F(n16_6),
    .I0(n84_8),
    .I1(n84_6),
    .I2(held_dir),
    .I3(motor_dir) 
);
defparam n16_s2.INIT=16'h7FFF;
  LUT4 n36_s1 (
    .F(n36_5),
    .I0(motor_dir),
    .I1(held_dir),
    .I2(n84_8),
    .I3(n84_6) 
);
defparam n36_s1.INIT=16'hEFFF;
  LUT2 n34_s2 (
    .F(n34_7),
    .I0(n36_5),
    .I1(n16_6) 
);
defparam n34_s2.INIT=4'h7;
  LUT3 motor_r_en_s0 (
    .F(motor_r_en),
    .I0(n36_5),
    .I1(n16_6),
    .I2(enabled) 
);
defparam motor_r_en_s0.INIT=8'h70;
  DFFR pwm_pair_0_s0 (
    .Q(pwm_pair[0]),
    .D(pwm),
    .CLK(clk_d),
    .RESET(n36_5) 
);
defparam pwm_pair_0_s0.INIT=1'b0;
  DFF enabled_s0 (
    .Q(enabled),
    .D(n34_7),
    .CLK(clk_d) 
);
defparam enabled_s0.INIT=1'b0;
  DFFE held_dir_s0 (
    .Q(held_dir),
    .D(motor_dir),
    .CLK(clk_d),
    .CE(n13_3) 
);
defparam held_dir_s0.INIT=1'b0;
  DFFR pwm_pair_1_s0 (
    .Q(pwm_pair[1]),
    .D(pwm),
    .CLK(clk_d),
    .RESET(n16_6) 
);
defparam pwm_pair_1_s0.INIT=1'b0;
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* ibt2_adapter */
